# ============================================
# Production Dockerfile (OPTIONAL)
# Multi-stage build for production releases
#
# To use this:
# 1. Uncomment the COPY lines below as needed
# 2. Update the COPY paths for your project structure
# 3. Ensure config/config.exs and config/prod.exs exist
# 4. Uncomment mix assets.deploy if you have assets
# 5. Uncomment mix release if using releases
# 6. Update the final CMD to match your app name
#
# Then build with: docker build -f docker/Dockerfile.prod .
# ============================================

ARG ELIXIR_VERSION=1.19.2
ARG OTP_VERSION=28.1
ARG DEBIAN_VERSION=trixie-20251103-slim

ARG BUILDER_IMAGE="docker.io/hexpm/elixir:${ELIXIR_VERSION}-erlang-${OTP_VERSION}-debian-${DEBIAN_VERSION}"
ARG RUNNER_IMAGE="docker.io/debian:${DEBIAN_VERSION}"

# ============================================
# Builder Stage
# ============================================
FROM ${BUILDER_IMAGE} AS builder

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    build-essential \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN mix local.hex --force && \
    mix local.rebar --force

ENV MIX_ENV="prod"

# Uncomment to install dependencies:
# COPY mix.exs mix.lock ./
# RUN mix deps.get --only $MIX_ENV
# RUN mix deps.compile

# Uncomment if your project has a config directory:
# COPY config/config.exs config/prod.exs config/

# Uncomment if your project has assets:
# RUN mix assets.setup
# COPY assets assets
# COPY priv priv
# COPY lib lib

# Uncomment to compile the application:
# RUN mix compile

# Uncomment to build assets for production:
# RUN mix assets.deploy

# Uncomment to build the release:
# COPY rel rel
# RUN mix release

# ============================================
# Runtime Stage
# ============================================
FROM ${RUNNER_IMAGE} AS runtime

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    libstdc++6 \
    openssl \
    libncurses6 \
    locales \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen && \
    locale-gen

ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8

WORKDIR /app

ENV MIX_ENV="prod"

# Uncomment to copy the release from builder:
# COPY --from=builder --chown=root:root /app/_build/prod/rel/your_app_name ./

# CMD ["/app/bin/server"]
