# ============================================
# Base Dockerfile
# Shared foundation for all environments
# This image contains only essential build tools
# ============================================

ARG ELIXIR_VERSION=1.19.2
ARG OTP_VERSION=28.1
ARG DEBIAN_VERSION=trixie-20251103-slim

ARG BASE_IMAGE="docker.io/hexpm/elixir:${ELIXIR_VERSION}-erlang-${OTP_VERSION}-debian-${DEBIAN_VERSION}"

FROM ${BASE_IMAGE}

RUN apt-get update -qq && \
  apt-get install -y --no-install-recommends \
    build-essential \
    git \
    curl \
    make \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN mix local.hex --force && \
    mix local.rebar --force
